# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# --- Site (required) ---
# Used for metadataBase, sitemap URLs and auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: service role key ---
# NOT needed to run the site. Nothing in the app calls it today — it exists for
# the SMS/WhatsApp notification stub in lib/notifications/sms.ts, which is not
# wired to any call site yet. The Edge Functions get their own copy injected by
# Supabase automatically, so you do not set it for them either.
# Only add this once something server-side genuinely needs to bypass RLS.
# Server-only — never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email (set as Supabase Edge Function secrets, NOT in Vercel) ---
# Sent through Gmail's own SMTP servers (authenticated as GMAIL_USER via an
# App Password), not a third-party API — the only way mail can legitimately
# claim to be from a gmail.com address at all.
# supabase secrets set GMAIL_USER=... GMAIL_APP_PASSWORD=... INTERNAL_FUNCTION_SECRET=...
# GMAIL_USER=tshewangdema535@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # 16-char Google App Password, not the account password
# INTERNAL_FUNCTION_SECRET=...             # matches the 'internal_function_secret' Vault entry; see migration 20260730104606
# ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com
