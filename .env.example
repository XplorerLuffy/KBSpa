# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Server-only. Never prefix with NEXT_PUBLIC_ — this key bypasses Row Level Security.
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (required) ---
# Used for metadataBase, sitemap URLs and auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (set as Supabase Edge Function secrets, NOT in Vercel) ---
# supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL=...
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=bookings@yourdomain.com
# ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com
