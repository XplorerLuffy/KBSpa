# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# --- Site (required) ---
# Used for metadataBase, sitemap URLs and auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: service role key ---
# NOT needed to run the site. Nothing in the app calls it today — it exists for
# the SMS/WhatsApp notification stub in lib/notifications/sms.ts, which is not
# wired to any call site yet. The Edge Functions get their own copy injected by
# Supabase automatically, so you do not set it for them either.
# Only add this once something server-side genuinely needs to bypass RLS.
# Server-only — never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email (set as Supabase Edge Function secrets, NOT in Vercel) ---
# supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL=...
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=bookings@yourdomain.com
# ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com
